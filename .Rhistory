###############################
### Chargement des packages ###
###############################
library(tidyverse)
library(questionr)
library(openxlsx)
###############################
### Importation des données ###
###############################
### Les données de l'enquête
# La vague courte (pour l'exemple, mais on pourra ajuster en mettant le df final !)
df_long <- read.csv("Data/panel_long.csv", sep=",")
### Les données externes (publiques et agrégées)
# Population des 15 ans et plus (2022) par commune stratifiée par catégorie d'âge, sexe et statut d'emploi
pop_strat <- read.csv("Data/Public data/TD_POP5_2022.csv", sep=";")
colnames(pop_strat)
# Grille de densité des communes (2023) pour avoir le nombre d'habitants et le type d'habitat (rural, périurbain, rural)
pop_co <- openxlsx::read.xlsx("Data/Public data/grille_densite_2026.xlsx", sep=";")
colnames(pop_co) <- pop_co[4,]
pop_co <- pop_co[5:nrow(pop_co), ]
pop_co <- pop_co |>
select(CODGEO, DENS, PMUN23) |>
mutate(PMUN23 = as.numeric(PMUN23))
# On joint le fichier des 15 ans et plus à la grille de densité
pop_strat <- pop_strat %>%
left_join(pop_co)
#################################
### Statistiques descriptives ###
#################################
# Part de chaque type de communes
#--------------------------------
### Dans la population totale
# On crée une variable avec la catégorie de communes (à partir de la grille de densité)
pop_co <- pop_co |>
# On transforme la variable de population en numérique (pour l'utiliser ensuite)
mutate(PMUN23 = as.numeric(PMUN23)) |>
# On crée la variable de type de commune (comme facteur)
mutate(type_co = factor(
case_when(
PMUN23 < 800 ~ "Hameau",
PMUN23 >= 800 & PMUN23 < 2000 ~ "Village",
PMUN23 >= 2000 & PMUN23 < 20000 ~ "Petite ville",
PMUN23 >= 20000 & PMUN23 < 100000 ~ "Ville moyenne",
PMUN23 >= 100000 ~ "Grande ville",
TRUE ~ NA
),
# On définit l'ordre des niveaux
levels = c(
"Hameau",
"Village",
"Petite ville",
"Ville moyenne",
"Grande ville"
)
))
# On regroupe les communes par catégorie et on somme leur nombre d'individus
tab_pop_co <- pop_co |>
group_by(type_co) |>
summarise(PMUN23_tot = sum(PMUN23), n = n()) |>
mutate(PMUN23_tot_prop = PMUN23_tot / sum(PMUN23_tot))
### Dans la population des 15 ans et plus
# On fusionne avec la grille de densité
pop_strat <- pop_strat |>
left_join(pop_co |> select(CODGEO, type_co),
by = "CODGEO"
)
# On calcule la population par commune
pop_strat_commune <- pop_strat |>
group_by(CODGEO, type_co) |>
summarise(
NB = sum(NB, na.rm = TRUE),
.groups = "drop"
)
# On calcule le total par catégorie de commune
tab_pop_strat <- pop_strat_commune |>
group_by(type_co) |>
summarise(
PMUN23_census = sum(NB, na.rm = TRUE),
n = n(),
.groups = "drop"
) |>
mutate(
PMUN23_census_prop = PMUN23_census / sum(PMUN23_census)
)
### Parmi nos enquêtés
tab_pop_enquetes <- df_long |>
group_by(G2Q00001) |>
summarise(
PMUN23_enquetes = n(),
.groups = "drop"
) |>
mutate(
G2Q00001 = recode(
G2Q00001,
"Dans un hameau (moins de 800 habitant·es)" = "Hameau",
"Dans un village (800-2000 habitant·es)" = "Village",
"Dans une petite ville (2000-20 000 habitant·es)" = "Petite ville",
"Dans une ville moyenne (20 000 - 100 000 habitant·es)" = "Ville moyenne",
"Dans une grande ville (+ de 100 000 habitant·es)" = "Grande ville"
),
PMUN23_enquetes_prop = PMUN23_enquetes / sum(PMUN23_enquetes)
) |>
rename('type_co' = 'G2Q00001')
# On fusionne les trois tables
tab_pop <- tab_pop_co |>
left_join(tab_pop_strat, by='type_co') |>
left_join(tab_pop_enquetes, by='type_co') |>
select(-c("n.x", "n.y")) |>
select("type_co", "PMUN23_tot", "PMUN23_census", "PMUN23_enquetes", "PMUN23_tot_prop", "PMUN23_census_prop", "PMUN23_enquetes_prop")
# Croisement Age*CSP*type_commune
#--------------------------------
### Population totale des 15 ans et plus (recensement)
# On renomme les catégories d'âge dans le fichier du recensement
pop_strat <- pop_strat |>
mutate(AGE_cat = case_when(
AGEQ65 == 15 ~ "15-19",
AGEQ65 == 20 ~ "20-24",
AGEQ65 == 25 ~ "25-29",
AGEQ65 == 30 ~ "30-34",
AGEQ65 == 35 ~ "35-39",
AGEQ65 == 40 ~ "40-44",
AGEQ65 == 45 ~ "45-49",
AGEQ65 == 50 ~ "50-54",
AGEQ65 == 55 ~ "55-59",
AGEQ65 == 60 ~ "60-64",
AGEQ65 == 65 ~ "65 et plus"
))
# On crée les mêmes catégories dans notre df
# (à reprendre quand la variable finale d'âge sera prête)
df_long <- df_long |>
mutate(AGE_cat = case_when(
G1Q00002_other < 20 | G1Q00002 < 20 ~ "15-19",
(G1Q00002_other >= 20 & G1Q00002_other < 25) | (G1Q00002 >= 20 & G1Q00002 < 25) ~ "20-24",
(G1Q00002_other >= 25 & G1Q00002_other < 30) | (G1Q00002 >= 25 & G1Q00002< 30) ~ "25-29",
(G1Q00002_other >= 30 & G1Q00002_other < 35) | (G1Q00002 >= 30 & G1Q00002 < 35) ~ "30-34",
(G1Q00002_other >= 35 & G1Q00002_other < 40) | (G1Q00002 >= 35 & G1Q00002 < 40) ~ "35-39",
(G1Q00002_other >= 40 & G1Q00002_other < 45) | (G1Q00002 >= 40 & G1Q00002 < 45) ~ "40-44",
(G1Q00002_other >= 45 & G1Q00002_other < 50) | (G1Q00002 >= 45 & G1Q00002 < 50) ~ "45-49",
(G1Q00002_other >= 50 & G1Q00002_other < 55) | (G1Q00002 >= 50 & G1Q00002 < 55) ~ "50-54",
(G1Q00002_other >= 55 & G1Q00002_other < 60) | (G1Q00002 >= 55 & G1Q00002 < 60) ~ "55-59",
(G1Q00002_other >= 60 & G1Q00002_other < 65) | (G1Q00002 >= 60 & G1Q00002 < 65) ~ "60-64",
(G1Q00002_other >= 65) | (G1Q00002 >= 65) ~ "65 et plus",
TRUE ~ NA
))
table(df_long$AGE_cat)
# On regarde s'il y a des NAs dans les populations
pop_strat |>
summarise(n_NA = sum(is.na(NB))) # 528 NAs
# Ils sont tous parmi des hameaux
pop_strat |>
filter(type_co == "Hameau") |>
summarise(n_NA = sum(is.na(NB)))
# On crée une variable actif occupé / sans emploi / retraité / étudiant
pop_strat <- pop_strat |>
mutate(statut = case_when(
TACTR == 11 ~ "Actif occupé",
TACTR == 12 ~ "Sans emploi",
TACTR == 21 ~ "Retraité",
TACTR == 22 ~ "Etudiant",
TACTR == 24 ~ "Sans emploi",
TACTR == 26 ~ "Sans emploi"
))
# On crée une table agrégée par sexe*age*type_co*statut dans la population insee
tab_pop_strat_croisee <- pop_strat |>
group_by(type_co, SEXE, AGE_cat, statut) |>
summarise(
pop_co_23 = sum(NB, na.rm = TRUE),
.groups = "drop"
)
