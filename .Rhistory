"Dans une ville moyenne (20 000 - 100 000 habitant·es)" = "Ville moyenne",
"Dans une grande ville (+ de 100 000 habitant·es)" = "Grande ville"
)) |>
group_by(G2Q00001, G1Q00001, AGE_cat, statut) |>
summarise(
pop_co_23 = n(),
.groups = "drop"
) |>
rename(SEXE = G1Q00001,
type_co = G2Q00001) |>
mutate(SEXE = ifelse(
SEXE == "Homme", 1, 2
))
tab_pop_croisee <- tab_pop_strat_croisee |> left_join(tab_pop_enquetes_croisee, by=c("AGE_cat", "statut", "type_co",
"SEXE"))
tab_pop_croisee |>
summarise(
n = n(),
n_NA_enquete = sum(is.na(pop_co_23.y)),
pct_NA_enquete = mean(is.na(pop_co_23.y)) * 100
)
